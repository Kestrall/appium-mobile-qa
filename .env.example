# Profil d'execution (voir config/devices.yaml)
DEVICE_PROFILE=android_real

# Serveur Appium
APPIUM_URL=http://127.0.0.1:4723

# Android : numero de serie donne par `adb devices`
ANDROID_UDID=

# iOS reel : UDID donne par `xcrun xctrace list devices`
IOS_UDID=
# Team ID Apple (compte gratuit possible) pour signer WebDriverAgent
XCODE_ORG_ID=
XCODE_SIGNING_ID=Apple Development

# Export Xray Cloud (optionnel)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=MQA
